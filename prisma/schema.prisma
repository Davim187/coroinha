generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDINATOR
  SECRETARY
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum CoroinhaStatus {
  ACTIVE
  INACTIVE
}

enum ScaleStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum LiturgicalRole {
  CRUCIFERARIO
  LIBRIFERO
  CREDENCIA
  OBJETOS
  CEROFERARIO_1
  CEROFERARIO_2
  TURIFERARIO
  NAVETEIRO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  JUSTIFIED
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum RaffleBlockStatus {
  OPEN
  PARTIAL
  SETTLED
  RETURNED
}

enum FundraisingStatus {
  ONGOING
  CLOSED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MeetingStatus {
  SCHEDULED
  HELD
  CANCELLED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            UserRole
  status          AccountStatus    @default(ACTIVE)
  permissions     String[]
  sessionVersion  Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  audits          AuditLog[]
  attendances         Attendance[]
  meetingAttendances  MeetingAttendance[]
  transactions        FinancialTransaction[]
  revisions           FinancialRevision[]
  meetings            Meeting[]
  meetingLinks        MeetingParticipant[]
  blockEvents         RaffleBlockEvent[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ip        String?

  @@index([userId])
}

model Coroinha {
  id            String         @id @default(cuid())
  fullName      String
  birthDate     DateTime       @db.Date
  phone         String?
  guardianName  String?
  guardianPhone String?
  joinedAt      DateTime       @db.Date
  notes         String?
  status        CoroinhaStatus @default(ACTIVE)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignments         ScaleAssignment[]
  participants        FundraisingParticipant[]
  contributions       FinancialTransaction[]
  blocks              RaffleBlock[]
  meetingAttendances  MeetingAttendance[]

  @@index([fullName])
  @@index([status, archivedAt])
}

model Celebration {
  id        String   @id @default(cuid())
  title     String
  date      DateTime @db.Date
  time      String
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scale     Scale?

  @@index([date])
}

model Scale {
  id               String      @id @default(cuid())
  celebrationId    String      @unique
  celebration      Celebration @relation(fields: [celebrationId], references: [id], onDelete: Cascade)
  status           ScaleStatus @default(DRAFT)
  duplicatedFromId String?
  publishedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  roles            ScaleRoleSetting[]
  assignments      ScaleAssignment[]

  @@index([status])
}

model ScaleRoleSetting {
  id      String         @id @default(cuid())
  scaleId String
  scale   Scale          @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  role    LiturgicalRole
  enabled Boolean        @default(true)

  @@unique([scaleId, role])
}

model ScaleAssignment {
  id             String         @id @default(cuid())
  scaleId        String
  scale          Scale          @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  role           LiturgicalRole
  coroinhaId     String
  coroinha       Coroinha       @relation(fields: [coroinhaId], references: [id], onDelete: Restrict)
  overrideReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attendance     Attendance?

  @@unique([scaleId, role])
  @@index([coroinhaId])
}

model Attendance {
  id           String           @id @default(cuid())
  assignmentId String           @unique
  assignment   ScaleAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status       AttendanceStatus
  notes        String?
  recordedById String
  recordedBy   User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model RaffleCampaign {
  id           String       @id @default(cuid())
  name         String
  description  String?
  prize        String
  unitPrice     Decimal      @db.Decimal(12, 2)
  blockCount    Int
  miniBlockSize Int
  firstNumber   Int      @default(1)
  firstBlock    Int      @default(1)
  totalNumbers  Int
  startsAt      DateTime     @db.Date
  endsAt       DateTime     @db.Date
  drawAt       DateTime?    @db.Date
  goalAmount   Decimal?     @db.Decimal(12, 2)
  notes        String?
  status       RaffleStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  batches      RaffleBatch[]
  blocks       RaffleBlock[]

  @@index([status])
}

model RaffleBatch {
  id            String         @id @default(cuid())
  campaignId    String
  campaign      RaffleCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  blockCount    Int
  miniBlockSize Int
  firstNumber   Int
  firstBlock    Int
  createdAt     DateTime       @default(now())
  blocks        RaffleBlock[]

  @@index([campaignId])
}

model RaffleBlock {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        RaffleCampaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  batchId         String
  batch           RaffleBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  label           String
  coroinhaId      String?
  coroinha        Coroinha?         @relation(fields: [coroinhaId], references: [id], onDelete: Restrict)
  participantName String
  quantity        Int
  soldQuantity    Int               @default(0)
  unsoldQuantity  Int               @default(0)
  unsoldReturned  Boolean           @default(false)
  amountReceived  Decimal           @db.Decimal(12, 2) @default(0)
  status          RaffleBlockStatus @default(OPEN)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  events          RaffleBlockEvent[]

  @@unique([campaignId, label])
  @@index([campaignId])
  @@index([batchId])
  @@index([coroinhaId])
}

model RaffleBlockEvent {
  id        String      @id @default(cuid())
  blockId   String
  block     RaffleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime    @default(now())

  @@index([blockId])
}

model FundraisingCampaign {
  id           String                   @id @default(cuid())
  name         String
  description  String?
  category     String
  startsAt     DateTime                 @db.Date
  endsAt       DateTime?                @db.Date
  goalAmount   Decimal?                 @db.Decimal(12, 2)
  notes        String?
  status       FundraisingStatus        @default(ONGOING)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  participants FundraisingParticipant[]
  transactions FinancialTransaction[]

  @@index([status])
}

model FundraisingParticipant {
  id         String              @id @default(cuid())
  campaignId String
  campaign   FundraisingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  coroinhaId String
  coroinha   Coroinha            @relation(fields: [coroinhaId], references: [id], onDelete: Restrict)
  note       String?
  createdAt  DateTime            @default(now())

  @@unique([campaignId, coroinhaId])
}

model FinancialTransaction {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     FundraisingCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  type         TransactionType
  amount       Decimal             @db.Decimal(12, 2)
  date         DateTime            @db.Date
  description  String
  coroinhaId   String?
  coroinha     Coroinha?           @relation(fields: [coroinhaId], references: [id], onDelete: Restrict)
  recordedById String
  recordedBy   User                @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  revisions    FinancialRevision[]

  @@index([campaignId, date])
}

model FinancialRevision {
  id            String               @id @default(cuid())
  transactionId String
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  before        Json
  after         Json
  note          String?
  createdAt     DateTime             @default(now())

  @@index([transactionId])
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  agenda       String?
  date         DateTime             @db.Date
  startTime    String
  endTime      String
  location     String?
  organizerId  String
  organizer    User                 @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  notes        String?
  decisions    String?
  status       MeetingStatus        @default(SCHEDULED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  participants MeetingParticipant[]
  attendances  MeetingAttendance[]

  @@index([date, status])
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String

  @@unique([meetingId, name])
  @@index([userId])
}

model MeetingAttendance {
  id           String           @id @default(cuid())
  meetingId    String
  meeting      Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  coroinhaId   String
  coroinha     Coroinha         @relation(fields: [coroinhaId], references: [id], onDelete: Restrict)
  status       AttendanceStatus
  notes        String?
  recordedById String
  recordedBy   User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([meetingId, coroinhaId])
  @@index([coroinhaId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  id                          String   @id @default("default")
  parishName                  String   @default("Pastoral de Coroinhas")
  celebrationDurationMinutes  Int      @default(90)
  balanceWindowDays           Int      @default(60)
  lastAttendanceReportMonth   String?
  updatedAt                   DateTime @updatedAt
}
