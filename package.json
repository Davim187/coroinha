{
  "name": "coroinha",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.prisma && turbo dev",
    "build": "prisma generate --schema prisma/schema.prisma && turbo build",
    "typecheck": "prisma generate --schema prisma/schema.prisma && turbo typecheck",
    "lint": "turbo lint",
    "test": "prisma generate --schema prisma/schema.prisma && turbo test",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:local": "node scripts/postgres.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @coroinha/api exec tsx ../../prisma/seed.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@prisma/client": "6.19.3",
    "embedded-postgres": "^18.1.0-beta.16",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/windows-x64",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
