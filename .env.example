# Banco local do Docker Compose. Troque a senha se o ambiente for compartilhado.
DATABASE_URL=postgresql://coroinha:coroinha@localhost:5432/coroinha

# Segredos longos e aleatórios. Não reutilize estes exemplos em produção.
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-de-acesso
JWT_REFRESH_SECRET=troque-por-um-segredo-longo-de-atualizacao

WEB_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=3333
NODE_ENV=development

# Use true somente atrás de HTTPS.
COOKIE_SECURE=false

# Primeiro administrador, criado pelo seed apenas se ainda não existir.
# A senha do administrador inicial precisa ter ao menos 8 caracteres, com letras e números.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@paroquia.local
ADMIN_PASSWORD=

BCRYPT_ROUNDS=12
